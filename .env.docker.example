# Copy this file outside the application tree, fill every required value, then:
# docker compose --env-file /secure/path/koma.docker.env up -d --build --wait

KOMA_APP_NAME=KomaEngine
KOMA_APP_URL=https://manga.example.com
KOMA_APP_PORT=8080
KOMA_APP_LOCALE=en

# Generate once with: php artisan key:generate --show
# Keep this stable across every container replacement and backup.
KOMA_APP_KEY=

KOMA_DB_DATABASE=komaengine
KOMA_DB_USERNAME=koma
KOMA_DB_PASSWORD=
KOMA_DB_ROOT_PASSWORD=

KOMA_SESSION_SECURE_COOKIE=true
KOMA_LOG_LEVEL=info
# Rotated container output kept per service: KOMA_LOG_MAX_FILE files of
# KOMA_LOG_MAX_SIZE each. Older output is discarded.
KOMA_LOG_MAX_SIZE=10m
KOMA_LOG_MAX_FILE=5
KOMA_DB_QUEUE_RETRY_AFTER=3660
KOMA_QUEUE_WORKER_TIMEOUT=3600

# Development checkouts use the defaults below. Trusted exact-revision builds
# replace them with the full commit, false, <VERSION>+<12-char commit>, and true.
KOMA_RELEASE_VERSION=1.0.0
KOMA_RELEASE_COMMIT=unavailable
KOMA_RELEASE_DIRTY=unknown
KOMA_RELEASE_BUILD_ID=development
KOMA_TRUSTED_BUILD=false

# Optional local-only Adminer profile port.
KOMA_ADMINER_PORT=8081
