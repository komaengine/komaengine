APP_NAME=KomaEngine
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# One log file per day; files older than LOG_DAILY_DAYS are removed. This
# bounds age, not bytes, so still watch disk usage under storage/logs.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=error

# Fill in the MySQL/MariaDB details from your hosting control panel
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=3660

# Public disk so uploaded manga pages are web-servable via /storage
FILESYSTEM_DISK=public

MAIL_MAILER=log
