{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://komaengine.dev/schema/koma-archive-v2.schema.json",
  "title": "Koma Archive v2 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "exported_at", "series"],
  "properties": {
    "format": { "const": "koma-archive" },
    "schema_version": { "const": 2 },
    "exported_at": { "$ref": "#/$defs/timestamp" },
    "series": { "$ref": "#/$defs/series" }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "nullableTimestamp": {
      "oneOf": [
        { "$ref": "#/$defs/timestamp" },
        { "type": "null" }
      ]
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
      "maxLength": 35
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archive_path", "mime_type", "sha256", "bytes", "width", "height"],
      "properties": {
        "archive_path": {
          "type": "string",
          "pattern": "^media/(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[A-Za-z0-9._/-]+$",
          "maxLength": 500
        },
        "mime_type": { "type": "string", "minLength": 1, "maxLength": 255 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "width": { "type": ["integer", "null"], "minimum": 1 },
        "height": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "name", "slug", "created_at", "updated_at"],
      "properties": {
        "source_id": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 255 },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "alternateTitle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "title", "type"],
      "properties": {
        "language": { "$ref": "#/$defs/language" },
        "title": { "type": "string", "minLength": 1, "maxLength": 255 },
        "type": { "enum": ["original", "alternate", "official", "romanized"] }
      }
    },
    "credit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "role": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$",
          "maxLength": 50
        },
        "type": { "enum": ["person", "organization"] }
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "external_id", "url"],
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "maxLength": 100
        },
        "external_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "url": {
          "type": ["string", "null"],
          "pattern": "^https?://[^\\s]+$",
          "maxLength": 2048
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id", "sort_order", "archive_path", "mime_type", "sha256",
        "bytes", "width", "height", "created_at", "updated_at"
      ],
      "properties": {
        "source_id": { "type": "integer", "minimum": 1 },
        "sort_order": { "type": "integer", "minimum": 0 },
        "archive_path": {
          "type": "string",
          "pattern": "^media/(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[A-Za-z0-9._/-]+$",
          "maxLength": 500
        },
        "mime_type": { "type": "string", "minLength": 1, "maxLength": 255 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "width": { "type": ["integer", "null"], "minimum": 1 },
        "height": { "type": ["integer", "null"], "minimum": 1 },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id", "number", "title", "scanlation_group", "language", "status",
        "published_at", "views", "created_at", "updated_at", "pages"
      ],
      "properties": {
        "source_id": { "type": "integer", "minimum": 1 },
        "number": { "type": "string", "pattern": "^[0-9]{1,6}\\.[0-9]{2}$" },
        "title": { "type": ["string", "null"], "maxLength": 255 },
        "scanlation_group": { "type": ["string", "null"], "maxLength": 255 },
        "language": {
          "oneOf": [
            { "$ref": "#/$defs/language" },
            { "type": "null" }
          ]
        },
        "status": { "enum": ["draft", "scheduled", "published"] },
        "published_at": { "$ref": "#/$defs/nullableTimestamp" },
        "views": { "type": "integer", "minimum": 0 },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" },
        "pages": {
          "type": "array",
          "items": { "$ref": "#/$defs/page" }
        }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id", "title", "alternate_titles", "slug", "author", "artist",
        "credits", "franchises", "characters", "source_references", "year",
        "publication_date", "work_format", "status", "reading_direction",
        "default_reader_mode", "content_rating", "is_public", "synopsis",
        "cover_hue", "views", "created_at", "updated_at", "genres", "tags",
        "cover", "cover_thumbnail", "chapters"
      ],
      "properties": {
        "source_id": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 255 },
        "alternate_titles": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/alternateTitle" }
        },
        "slug": { "type": "string", "minLength": 1, "maxLength": 255 },
        "author": { "type": ["string", "null"], "maxLength": 255 },
        "artist": { "type": ["string", "null"], "maxLength": 255 },
        "credits": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/credit" }
        },
        "franchises": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 255 }
        },
        "characters": {
          "type": "array",
          "maxItems": 500,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 255 }
        },
        "source_references": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/sourceReference" }
        },
        "year": { "type": ["integer", "null"] },
        "publication_date": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "work_format": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
          "maxLength": 100
        },
        "status": { "enum": ["ongoing", "completed", "hiatus"] },
        "reading_direction": { "enum": ["rtl", "ltr", "vertical"] },
        "default_reader_mode": { "enum": ["rtl", "ltr", "vertical", null] },
        "content_rating": { "enum": ["safe", "mature"] },
        "is_public": { "type": "boolean" },
        "synopsis": { "type": ["string", "null"] },
        "cover_hue": { "type": "integer", "minimum": 0, "maximum": 359 },
        "views": { "type": "integer", "minimum": 0 },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" },
        "genres": {
          "type": "array",
          "items": { "$ref": "#/$defs/taxonomy" }
        },
        "tags": {
          "type": "array",
          "items": { "$ref": "#/$defs/taxonomy" }
        },
        "cover": {
          "oneOf": [
            { "$ref": "#/$defs/media" },
            { "type": "null" }
          ]
        },
        "cover_thumbnail": {
          "oneOf": [
            { "$ref": "#/$defs/media" },
            { "type": "null" }
          ]
        },
        "chapters": {
          "type": "array",
          "items": { "$ref": "#/$defs/chapter" }
        }
      }
    }
  }
}
