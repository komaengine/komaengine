{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://komaengine.example/schema/koma-site-backup-v1.schema.json",
  "title": "KomaEngine full-site backup manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "created_at",
    "backup_tool",
    "database",
    "release",
    "secrets",
    "files"
  ],
  "properties": {
    "format": {
      "const": "koma-site-backup-v1"
    },
    "schema_version": {
      "const": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "backup_tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "KomaEngine"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driver", "server_version", "artifact"],
      "properties": {
        "driver": {"enum": ["sqlite", "mysql", "mariadb"]},
        "server_version": {"type": "string", "minLength": 1},
        "artifact": {"$ref": "#/$defs/file"}
      },
      "allOf": [
        {
          "if": {"properties": {"driver": {"const": "sqlite"}}},
          "then": {
            "properties": {
              "artifact": {
                "allOf": [
                  {"$ref": "#/$defs/file"},
                  {"properties": {"path": {"const": "database/database.sqlite"}}}
                ]
              }
            }
          },
          "else": {
            "properties": {
              "artifact": {
                "allOf": [
                  {"$ref": "#/$defs/file"},
                  {"properties": {"path": {"const": "database/database.sql"}}}
                ]
              }
            }
          }
        }
      ]
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "composer_lock", "extensions"],
      "oneOf": [
        {
          "required": ["build_metadata"],
          "properties": {"identity": {"$ref": "#/$defs/currentIdentity"}}
        },
        {
          "not": {"required": ["build_metadata"]},
          "properties": {"identity": {"$ref": "#/$defs/legacyIdentity"}}
        }
      ],
      "properties": {
        "identity": {
          "oneOf": [
            {"$ref": "#/$defs/legacyIdentity"},
            {"$ref": "#/$defs/currentIdentity"}
          ]
        },
        "composer_lock": {
          "allOf": [
            {"$ref": "#/$defs/file"},
            {"properties": {"path": {"const": "release/composer.lock"}}}
          ]
        },
        "build_metadata": {
          "anyOf": [
            {
              "allOf": [
                {"$ref": "#/$defs/file"},
                {"properties": {"path": {"const": "release/KOMA-BUILD-METADATA.txt"}}}
              ]
            },
            {"type": "null"}
          ]
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "name", "enabled", "manifest", "files"],
            "properties": {
              "kind": {"enum": ["plugin", "theme"]},
              "name": {"type": "string", "minLength": 1},
              "enabled": {"type": "boolean"},
              "manifest": {"$ref": "#/$defs/file"},
              "files": {
                "type": "array",
                "minItems": 1,
                "items": {"$ref": "#/$defs/file"}
              }
            }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle", "format"],
      "properties": {
        "bundle": {"$ref": "#/$defs/file"},
        "format": {"type": "string", "minLength": 1}
      }
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "bytes", "sha256"],
        "properties": {
          "role": {
            "enum": ["database", "public_media", "private_input", "release", "secret_bundle"]
          },
          "path": {"$ref": "#/$defs/path"},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "legacyIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_commit", "composer_lock_sha256", "build_metadata_sha256"],
      "properties": {
        "git_commit": {"type": "string", "minLength": 1},
        "composer_lock_sha256": {"$ref": "#/$defs/sha256"},
        "build_metadata_sha256": {
          "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      }
    },
    "currentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "git_commit",
        "composer_lock_sha256",
        "build_metadata_sha256",
        "build_id",
        "source_dirty"
      ],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
        "git_commit": {
          "anyOf": [
            {"const": "unavailable"},
            {"type": "string", "pattern": "^[a-f0-9]{40}$"}
          ]
        },
        "composer_lock_sha256": {"$ref": "#/$defs/sha256"},
        "build_metadata_sha256": {
          "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "build_id": {"type": "string", "minLength": 1},
        "source_dirty": {"type": ["boolean", "null"]}
      }
    }
  }
}
